# OctoFit Tracker - Frontend Environment Configuration
# 
# Copy this file to .env.local and update with your values.
# 
# IMPORTANT: The VITE_CODESPACE_NAME variable is REQUIRED for API calls to work.
# It is used to construct the API endpoint URL:
# https://${VITE_CODESPACE_NAME}--8000.app.github.dev/api/[endpoint]/

# The name of your GitHub Codespace (without the -8000 suffix)
# Example: if your backend is at my-app-dev--8000.app.github.dev, use "my-app-dev"
VITE_CODESPACE_NAME=your-codespace-name
